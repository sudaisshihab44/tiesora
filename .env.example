# ── Tiesora Environment Variables ────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Supabase (required for authentication + database) ─────────────────────────
# Find these in: Supabase Dashboard → Project Settings → API
# The anon key is safe to expose in frontend code (RLS enforces access control).
# NEVER put the service_role key here or in any frontend file.
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── Groq AI (required for PDF import AI extraction) ───────────────────────────
# Get your API key from: https://console.groq.com/keys
# Used for extracting family member data from uploaded PDF documents
VITE_GROQ_API_KEY=your_groq_api_key_here

# ── Gemini AI (optional - fallback for AI Heritage Assistant) ─────────────────
# Get your API key from: https://aistudio.google.com/app/apikey
# Only required if you want to use Gemini instead of Groq
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# ── App URL (automatically set by hosting platform in production) ─────────────
VITE_APP_URL=http://localhost:3000
