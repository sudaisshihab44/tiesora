# ── Tiesora Environment Variables ────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Supabase (required for authentication + database) ─────────────────────────
# Find these in: Supabase Dashboard → Project Settings → API
# The anon key is safe to expose in frontend code (RLS enforces access control).
# NEVER put the service_role key here or in any frontend file.
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── AI extraction (Supabase Edge Function) ────────────────────────────────────
# Provider keys are Supabase secrets, never VITE_* variables:
#   supabase secrets set AI_PROVIDER=gemini
#   supabase secrets set GEMINI_API_KEY=...
#   supabase secrets set GEMINI_MODEL=gemini-3.5-flash-lite
#   supabase secrets set GEMINI_MODEL_FALLBACKS=gemini-3.6-flash,gemini-3.8-flash
#   supabase secrets set GROQ_API_KEY=...
#   supabase secrets set GROQ_MODEL=openai/gpt-oss-120b
# See docs/EDGE_FUNCTION.md.

# ── App URL (automatically set by hosting platform in production) ─────────────
VITE_APP_URL=http://localhost:3000

# ── Local bootstrap test users (development only) ─────────────────────────────
# Public sign-up path (email confirmation must be OFF):
#   node scripts/bootstrap-via-signup.mjs
# Service-role path (requires SUPABASE_SERVICE_ROLE_KEY below):
#   node scripts/bootstrap-users.mjs
# Passwords are read from this file; leave them empty to generate random ones.
BOOTSTRAP_ADMIN_EMAIL=admin@tiesora.test
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_VIEWER_EMAIL=viewer@tiesora.test
BOOTSTRAP_VIEWER_PASSWORD=

# Used ONLY by scripts/bootstrap-users.mjs. NEVER prefix with VITE_ and never
# commit this value. Remove it after bootstrapping.
SUPABASE_SERVICE_ROLE_KEY=

# ── Supabase CLI deployment (Edge Function) ──────────────────────────────────
# Personal access token: Supabase Dashboard -> Account -> Access Tokens.
SUPABASE_ACCESS_TOKEN=

# Gemini/Groq keys used only to set Edge Function secrets. Never prefix with VITE_.
GEMINI_API_KEY=
GROQ_API_KEY=
