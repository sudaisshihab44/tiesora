# ── Tiesora Environment Variables ────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Gemini AI (required for AI Heritage Assistant) ────────────────────────────
# AI Studio injects this automatically at runtime. Set manually for local dev.
VITE_GEMINI_API_KEY="your_gemini_api_key_here"

# ── Supabase (required for real auth + database) ──────────────────────────────
# Find these in: Supabase Dashboard → Project Settings → API
# The anon key is safe to expose in frontend code (RLS enforces access control).
# NEVER put the service_role key here or in any frontend file.
VITE_SUPABASE_URL="https://yuysjdytkofnblusdtvu.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inl1eXNqZHl0a29mbmJsdXNkdHZ1Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTI4MTUyNDksImV4cCI6MjEwODM5MTI0OX0.ABpPsSVVJZyFt-X2XXOdV8N5BeKZjigwXQkYQpMVboM"

# ── App URL (set automatically by AI Studio in production) ───────────────────
