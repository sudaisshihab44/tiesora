# ── Tiesora Environment Variables ────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Supabase (required for authentication + database) ─────────────────────────
# Find these in: Supabase Dashboard → Project Settings → API
# The anon key is safe to expose in frontend code (RLS enforces access control).
# NEVER put the service_role key here or in any frontend file.
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── AI extraction (Supabase Edge Function) ────────────────────────────────────
# The provider key is a Supabase secret, never a VITE_* variable:
#   supabase secrets set GROQ_API_KEY=gsk_...
#   (optional) supabase secrets set GEMINI_API_KEY=...
#   (optional) supabase secrets set GROQ_MODEL=llama-3.1-70b-versatile
# See docs/EDGE_FUNCTION.md.

# ── App URL (automatically set by hosting platform in production) ─────────────
VITE_APP_URL=http://localhost:3000

# ── Local bootstrap test users (development only) ─────────────────────────────
# Run `node scripts/bootstrap-users.mjs` after filling these in.
# Leave passwords empty to generate random ones.
BOOTSTRAP_ADMIN_EMAIL=admin@tiesora.test
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_VIEWER_EMAIL=viewer@tiesora.test
BOOTSTRAP_VIEWER_PASSWORD=

# Used ONLY by scripts/bootstrap-users.mjs. NEVER prefix with VITE_ and never
# commit this value. Remove it after bootstrapping.
SUPABASE_SERVICE_ROLE_KEY=
